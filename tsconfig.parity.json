{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "app/(pro)/**/*.ts",
    "app/(pro)/**/*.tsx",
    "components/prod/**/*.ts",
    "components/prod/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
